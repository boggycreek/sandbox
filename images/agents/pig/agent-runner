# In-Container Dispatch Wrapper for PiG (Pi in Go) Agent
# Adheres to the /usr/local/bin/agent-runner dispatch contract (ADR 00039).
# Invoked non-interactively by bpd upon draining backplane messages.

set -euo pipefail

ROLE="${AGENT_ROLE:-${ROLE:-fuzzer}}"
PIGLET_FILE="${PIGLET_FILE:-/home/agent/.pig/piglets/${ROLE}.yaml}"

# Consume prompt from standard input
PROMPT="$(cat)"

# If prompt is empty or whitespace only, nothing to process
if [[ -z "${PROMPT//[[:space:]]/}" ]]; then
  exit 0
fi

# Execute PiG non-interactively (-p)
if [ -f "${PIGLET_FILE}" ]; then
  exec pig --piglet "${PIGLET_FILE}" -p "${PROMPT}"
else
  exec pig -p "${PROMPT}"
fi
