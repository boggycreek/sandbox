# Front Lobe: Fast Reflex Dispatcher (ADR 00040)
# Invoked non-interactively by bpd upon draining backplane messages.
# Evaluates message against shared state (~/.agent/state.json).
# Directly answers status inquiries, or enqueues actionable directives.

set -euo pipefail

RAW_INPUT="$(cat)"
if [[ -z "${RAW_INPUT//[[:space:]]/}" ]]; then
  exit 0
fi

STATE_FILE="${HOME:-/home/agent}/.agent/state.json"
mkdir -p "$(dirname "${STATE_FILE}")"

# Initialize state if not present
if [ ! -f "${STATE_FILE}" ]; then
  cat <<EOF > "${STATE_FILE}"
{
  "agent_id": "${AGENT_NAME:-agent}",
  "status": "idle",
  "current_task": "none",
  "activity": "idle, waiting for task",
  "active_branch": "main",
  "updated_at": "$(date -u +%FT%TZ)"
}
EOF
fi

# Process lines in batch
while IFS= read -r line; do
  [[ -z "${line//[[:space:]]/}" ]] && continue

  python3 - <<PYEOF "${line}"
import sys, re, subprocess, json, os

line = sys.argv[1]
current_agent = os.environ.get("AGENT_NAME", os.environ.get("BP_AGENT", "")).strip().lower()

# Format: HH:MM:SS [sender#seq -> target [verified]]: message
m = re.match(r'^\S+\s+\[([a-zA-Z0-9_-]+)#(\d+)(?:\s+->\s+([a-zA-Z0-9_-]+))?(?:\s+\[[^\]]+\])?\]:\s*(.*)$', line)
if not m:
    sender = "operator"
    seq = "0"
    target = current_agent
    citation = "operator#0"
    content = line.strip()
else:
    sender = m.group(1).strip()
    seq = m.group(2).strip()
    target = m.group(3).strip().lower() if m.group(3) else ""
    citation = f"{sender}#{seq}"
    content = m.group(4).strip()

if not content:
    sys.exit(0)

# Ignore self-messages
if sender.lower() == current_agent:
    sys.exit(0)

human_name = os.environ.get("HUMAN_NAME", "brian").strip().lower()
is_from_human = sender.lower() in [human_name, "brian", "operator"]

# If message has no explicit target (public broadcast):
# Process if sent by human operator; ignore peer broadcasts to avoid feedback loops.
if not target:
    if not is_from_human:
        sys.exit(0)
elif target != current_agent:
    # Message was directed to a different agent's inbox
    sys.exit(0)

lower_content = content.lower()

# Suppress automated feedback loops, acknowledgments, completions, and status broadcasts
automated_prefixes = [
    "understood. directive queued",
    "completed directive:",
    "execution failed",
    "status:",
    "online (container started)",
    "ok ("
]
if any(lower_content.startswith(p) for p in automated_prefixes):
    sys.exit(0)

state_file = os.path.expanduser("~/.agent/state.json")
current_state = {}
try:
    with open(state_file, "r") as f:
        current_state = json.load(f)
except Exception:
    current_state = {"status": "idle", "activity": "idle", "current_task": "none"}

activity = current_state.get("activity", "idle")
task = current_state.get("current_task", "none")
status = current_state.get("status", "idle")

is_inquiry = any(k in lower_content for k in ["status", "what are you", "what're you", "how are you", "progress", "doing?", "check in"])

if is_inquiry:
    reply_msg = f"Status: {status} | Current task: {task} | Activity: {activity}"
    subprocess.run(["bp", "reply", citation, sender, reply_msg], check=False)
else:
    subprocess.run(["bp", "state", "queue", "push", line], check=False)
    ack_msg = f"Understood. Directive queued for execution (Task: {task})"
    subprocess.run(["bp", "reply", citation, sender, ack_msg], check=False)

PYEOF

done <<< "${RAW_INPUT}"
